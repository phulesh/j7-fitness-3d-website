    "@react-three/fiber": "^8.17.14",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "docx": "^9.1.0",
    "framer-motion": "^11.15.0",
    "jose": "^5.9.6",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "nanoid": "^5.0.9",
    "next": "^14.2.21",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.5",
    "three": "^0.170.0",
    "zod": "^3.24.1"
