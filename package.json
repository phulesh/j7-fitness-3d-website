{
  "name": "folio-ebook-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Research-based multilingual AI ebook generator",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "test:relevance": "npx --yes tsx src/lib/research/relevance-selftest.ts",
    "test:upgrade": "npx --yes tsx src/lib/ebook-selftest.ts",
    "postinstall": "node scripts/ensure-dirs.js && node scripts/seed-corpus.mjs"
  },
  "dependencies": {
