{
  "name": "folio-ebook-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Research-based multilingual AI ebook generator",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "test": "npm run test:persistence",
    "test:relevance": "NODE_OPTIONS=--conditions=react-server npx --yes tsx src/lib/research/relevance-selftest.ts",
    "test:upgrade": "NODE_OPTIONS=--conditions=react-server npx --yes tsx src/lib/ebook-selftest.ts",
    "test:flow": "NODE_OPTIONS=--conditions=react-server npx --yes tsx src/lib/folio-flow-selftest.ts",
    "test:3d": "NODE_OPTIONS=--conditions=react-server npx --yes tsx src/lib/flipbook-selftest.ts",
    "test:complete": "NODE_OPTIONS=--conditions=react-server tsx src/lib/complete-pipeline-selftest.ts",
    "test:qa": "NODE_OPTIONS=--conditions=react-server npx --yes tsx src/lib/qa-selftest.ts",
    "test:ai": "NODE_OPTIONS=--conditions=react-server tsx src/lib/ai-selftest.ts",
    "test:persistence": "node scripts/persistence-e2e.mjs",
    "test:vedanta": "NODE_OPTIONS=--conditions=react-server npx --yes tsx src/lib/vedanta-pipeline-selftest.ts",
    "postinstall": "node scripts/ensure-dirs.js && node scripts/seed-corpus.mjs",
    "test:ai:real": "NODE_OPTIONS=--conditions=react-server tsx scripts/ai-provider-integration.ts",
    "test:persistence:after-restart": "node scripts/persistence-after-restart.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.120.4",
    "@react-three/fiber": "^8.17.14",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "docx": "^9.1.0",
    "framer-motion": "^11.15.0",
    "jose": "^5.9.6",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "nanoid": "^5.0.9",
    "next": "^14.2.21",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.13.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "three": "^0.170.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.8",
    "@types/react": "^18.3.16",
    "@types/react-dom": "^18.3.5",
    "@types/sanitize-html": "^2.13.0",
    "@types/three": "^0.170.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.21",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
