# Database (required). The file path MUST be on persistent storage in production.
# Folio refuses non-file URLs in this build and never falls back to browser storage.
DATABASE_URL=file:./data/folio.db

# Server-side AI provider. All four are required for generation.
# AI_PROVIDER: openai-compatible | openai | anthropic
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional web search provider: tavily | brave | serper | auto
SEARCH_PROVIDER=auto
SEARCH_API_KEY=

# App
NEXT_PUBLIC_APP_NAME=Folio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Limits
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_HOUR=20
