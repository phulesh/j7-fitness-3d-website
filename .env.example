# Required for signed sessions
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: OpenAI-compatible or Anthropic key for higher-quality writing
# Never expose this to the browser.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional web search provider: tavily | brave | serper | auto
SEARCH_PROVIDER=auto
SEARCH_API_KEY=

# App
NEXT_PUBLIC_APP_NAME=Folio
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=file:./data/folio.db

# Limits
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_HOUR=20
