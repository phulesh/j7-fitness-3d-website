# Local development only. In production use an absolute path on a mounted volume.
DATABASE_URL=file:./data/folio.db

# Server-side AI provider. All four values are required; there are no production defaults.
# OpenAI-compatible example (OpenAI):
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Other OpenAI-compatible vendors use their documented API root ending in /v1
# (not the /chat/completions path) and that vendor's exact model identifier.

# Optional web search provider: tavily | brave | serper | auto
SEARCH_PROVIDER=auto
SEARCH_API_KEY=

# App
NEXT_PUBLIC_APP_NAME=Folio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Limits
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_HOUR=20
