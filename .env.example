# Database. Local development default below. In production the app anchors the
# database to the persistent Railway volume: relative URLs such as
# file:./data/folio.db resolve to file:/app/data/folio.db (volume mounted at
# /app/data, see RAILWAY_VOLUME_MOUNT_PATH). An absolute
# DATABASE_URL=file:/app/data/folio.db is used as-is.
DATABASE_URL=file:./data/folio.db

# ---------------------------------------------------------------------------
# AI provider (server-side only, OpenAI-compatible)
# ---------------------------------------------------------------------------
# All four are read from process.env at RUNTIME ONLY. Never NEXT_PUBLIC_*,
# never an ARG/ENV in the Dockerfile, never committed to source control.
# In production set these as Railway service variables.
#
# Any OpenAI-compatible vendor works with no code change. AI_PROVIDER is a free
# -form label used for logging/health output; the request format is OpenAI's
# unless it is literally "anthropic". No vendor is required or assumed.
#
#   OpenAI       AI_BASE_URL=https://api.openai.com/v1      AI_MODEL=gpt-4o-mini
#   OpenRouter   AI_BASE_URL=https://openrouter.ai/api/v1   AI_MODEL=openai/gpt-4o-mini
#   Groq         AI_BASE_URL=https://api.groq.com/openai/v1 AI_MODEL=llama-3.3-70b-versatile
#   Together     AI_BASE_URL=https://api.together.xyz/v1    AI_MODEL=Qwen/Qwen2.5-72B-Instruct-Turbo
#   DeepSeek     AI_BASE_URL=https://api.deepseek.com/v1    AI_MODEL=deepseek-chat
#   Anthropic    AI_PROVIDER=anthropic AI_BASE_URL=https://api.anthropic.com/v1
#
# AI_BASE_URL must be the API ROOT ending in /v1 — not /chat/completions.
# AI_MODEL must be the vendor's exact model ID.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional rate-limit tuning (server-side only, defaults shown). Generation
# always serialises AI requests (concurrency 1) and retries HTTP 429/5xx with
# exponential backoff + jitter, honouring the provider's Retry-After header.
# AI_MIN_REQUEST_INTERVAL_MS = minimum gap between consecutive AI requests.
AI_MIN_REQUEST_INTERVAL_MS=1000

# Optional web search provider: tavily | brave | serper | auto
# SEARCH_API_KEY is a runtime secret. If it is missing, external web search is
# gracefully disabled and research falls back to the local corpus plus keyless
# scholarly sources (Wikipedia, arXiv, Crossref, Open Library, PubMed).
SEARCH_PROVIDER=auto
SEARCH_API_KEY=

# App
NEXT_PUBLIC_APP_NAME=Folio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Limits
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_HOUR=20
